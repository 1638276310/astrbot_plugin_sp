  "recall": {
    "description": "默认开启消息撤回",
    "type": "bool",
    "default": true
  },
  "recall_time": {
    "description": "默认撤回时间（秒）",
    "type": "int",
    "default": 40,
    "hint": "允许范围 10 - 120 秒。"
  },
  "r18_mode": {
    "description": "R18 模式",
    "type": "string",
    "default": "all",
    "options": ["all", "safe", "r18"],
    "labels": ["0 全部", "1 非 R18", "2 R18"]
  },
  "image_preference": {
    "description": "图片偏好",
    "type": "string",
    "default": "popular_d",
    "options": ["popular_d", "popular_male_d", "popular_female_d"],
    "labels": ["0 无偏好", "1 男性偏好", "2 女性偏好"]
  },
  "track_pixel": {
    "description": "给下载的图片叠加噪点",
    "type": "bool",
    "default": true,
    "hint": "对应原插件的 sharp-pixel 处理，用于规避部分图床/风控。"
  },
  "max_concurrent_download": {
    "description": "图片下载并发数",
    "type": "int",
    "default": 5
  },
  "download_timeout": {
    "description": "单张图片下载超时（秒）",
    "type": "int",
    "default": 20
  },
  "batch_size": {
    "description": "合并转发每批图片数量",
    "type": "int",
    "default": 20
  },
  "max_pages_per_album": {
    "description": "单个套图最多解析的页数",
    "type": "int",
    "default": 20
  },
  "random_interval": {
    "description": "随机间隔（秒）",
    "type": "int",
    "default": 2,
    "hint": "同一次请求内多张图片/多个作品之间的随机等待时间上限。"
  },
  "subscribe_check_interval": {
    "description": "订阅推送检查间隔（小时）",
    "type": "int",
    "default": 4
  },
  "enable_scheduler": {
    "description": "启用内置定时任务",
    "type": "bool",
    "default": true,
    "hint": "启用后自动执行：订阅推送检查、套图列表增量更新、写真ID增量更新。"
  },
  "scheduler_mzt_cron": {
    "description": "写真ID自动更新时间（HH:MM）",
    "type": "string",
    "default": "07:30"
  },
  "scheduler_mtb_cron": {
    "description": "套图列表自动更新时间（HH:MM）",
    "type": "string",
    "default": "09:30"
  },
  "enable_id_whitelist": {
    "description": "启用会话白名单",
    "type": "bool",
    "default": false,
    "hint": "开启后，仅允许下方列表中的群号/QQ号使用本插件。"
  },
  "id_whitelist": {
    "description": "会话白名单",
    "type": "list",
    "default": []
  },
  "enable_group_limit": {
    "description": "启用订阅数量限制",
    "type": "bool",
    "default": true,
    "hint": "限制订阅画师的会话数量与单会话画师数量。"
  },
  "max_subscribe_sessions": {
    "description": "最多允许订阅的会话数",
    "type": "int",
    "default": 5
  },
  "max_artists_per_session": {
    "description": "单个会话最多订阅的画师数",
    "type": "int",
    "default": 20
  },
  "forward_as_node": {
    "description": "使用合并转发（OneBot 节点）发送多图",
    "type": "bool",
    "default": true,
    "hint": "关闭后，多图会以普通消息分批发送。部分平台不支持合并转发。"
  }
}
